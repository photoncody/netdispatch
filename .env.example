# =============================================================================
# netdispatch configuration
# Copy to .env and edit. The hub (server + samba) and relays read this file;
# on a relay-only host you only need the "Relay" section.
# =============================================================================

# -----------------------------------------------------------------------------
# Hub: URLs
# -----------------------------------------------------------------------------
# Public URL of the web UI (what users type; your reverse proxy's address).
# Used for OIDC redirect URIs and as the default boot URL.
PUBLIC_URL=https://pxe.example.com

# URL PXE clients use for boot scripts and payloads. Defaults to PUBLIC_URL.
# Set this to a plain-HTTP LAN address (e.g. http://10.0.0.5:8000) when the
# proxy's certificate is not trusted by iPXE, or to keep multi-GB WIM
# transfers off TLS. Relays should use the same value for CENTRAL_SERVER_URL.
BOOT_BASE_URL=

# Reverse proxies allowed to set X-Forwarded-For / X-Forwarded-Proto
# (comma-separated IPs/CIDRs, or * to trust any). Read by uvicorn.
FORWARDED_ALLOW_IPS=127.0.0.1

# Host port the hub's HTTP server is published on.
HUB_HTTP_PORT=8000

# Where data lives on the host (database, ISOs, extracted trees, templates).
DATA_PATH=./data

# -----------------------------------------------------------------------------
# Hub: sessions
# -----------------------------------------------------------------------------
# Signs session cookies. Leave empty to auto-generate one in /data/secret_key.
SECRET_KEY=
# Session lifetime in seconds.
SESSION_MAX_AGE=43200

# -----------------------------------------------------------------------------
# Hub: OIDC single sign-on (Authlib)
# -----------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Discovery document, e.g. https://auth.example.com/application/o/netdispatch/.well-known/openid-configuration
OIDC_METADATA_URL=
OIDC_SCOPES=openid email profile
# Button label on the login page.
OIDC_PROVIDER_NAME=SSO
# Only allow members of these groups (comma-separated). Empty = any user the IdP authenticates.
OIDC_ALLOWED_GROUPS=
# Claim containing group names.
OIDC_GROUPS_CLAIM=groups
# Send unauthenticated browsers straight to the IdP. /login?local=true always shows the local login.
AUTO_REDIRECT_SSO=false

# -----------------------------------------------------------------------------
# Hub: emergency local admin
# -----------------------------------------------------------------------------
FALLBACK_ADMIN_ENABLED=true
FALLBACK_ADMIN_USERNAME=admin
# Empty: a random password is generated on first start, logged once, and stored
# in /data/initial_admin_password.
FALLBACK_ADMIN_PASSWORD=
# Failed attempts allowed per client IP within the window (seconds).
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Hub: relays
# -----------------------------------------------------------------------------
# Optional bootstrap key: relays presenting it are auto-registered. Prefer the
# per-relay keys created under Relays -> Add relay (revocable individually).
RELAY_API_KEY=
# A relay is shown offline after this many seconds without a heartbeat.
RELAY_OFFLINE_SECONDS=90
# What generated compose snippets build/pull the relay from.
RELAY_BUILD_CONTEXT=https://github.com/photoncody/netdispatch.git#main:relay
# Set to use a pre-built image instead, e.g. registry.example.com/netdispatch-relay:latest
RELAY_IMAGE=

# -----------------------------------------------------------------------------
# Hub: boot behaviour
# -----------------------------------------------------------------------------
# Seconds between polls in the wait loop.
WAIT_POLL_SECONDS=5
# A device is shown offline after this many seconds without a poll.
DEVICE_OFFLINE_SECONDS=60
# State for never-seen MACs: "waiting" (hold loop) or "local" (boot local disk
# until an admin dispatches something).
NEW_DEVICE_STATE=waiting

# -----------------------------------------------------------------------------
# Hub: SMB share for Windows Setup (samba container)
# -----------------------------------------------------------------------------
# Host/IP WinPE uses to reach the samba container. Defaults to the host of
# BOOT_BASE_URL (or PUBLIC_URL).
SMB_HOST=
SMB_SHARE=netdispatch
SMB_USERNAME=netdispatch
# Required for Windows Setup deployments. No double quotes.
SMB_PASSWORD=
# Host address the SMB port binds to.
SMB_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Relay (docker-compose.relay.yml, or the hub's "local-relay" profile)
# -----------------------------------------------------------------------------
# Hub URL used by iPXE clients AND the heartbeat (normally = BOOT_BASE_URL).
CENTRAL_SERVER_URL=http://10.0.0.5:8000
# Unique ID: lowercase letters, digits, . _ -
RELAY_ID=site-office-vlan20
RELAY_NAME=Office VLAN 20
# Per-relay key from the UI (or the bootstrap RELAY_API_KEY above).
# For the hub's local-relay profile you can set LOCAL_RELAY_API_KEY instead.
# RELAY_API_KEY=
# Interface on the PXE subnet. Default: interface of the default route.
RELAY_INTERFACE=
# dnsmasq ProxyDHCP range, e.g. 192.168.20.0,proxy  Default: derived from RELAY_INTERFACE.
SUBNET_RANGE=
# UEFI boot file: ipxe.efi (iPXE NIC drivers) or snponly.efi (firmware NIC driver,
# more compatible with some NICs).
UEFI_BOOTFILE=ipxe.efi
# Clients whose firmware/NIC ROM already runs iPXE (e.g. Proxmox/QEMU VMs):
#   chainload - give them netdispatch's iPXE build too (HTTPS + your CA; default)
#   direct    - let them fetch the boot script directly (one TFTP transfer less)
IPXE_CLIENTS=chainload
# Log every DHCP exchange (useful while setting up).
RELAY_LOG_DHCP=true
HEARTBEAT_INTERVAL=30
