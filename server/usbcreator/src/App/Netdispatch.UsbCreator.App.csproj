<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app (Avalonia). Published self-contained as one .exe for win-x64; it
       builds on Linux too (CI, the hub's Dockerfile). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Netdispatch.UsbCreator.App</RootNamespace>
    <AssemblyName>netdispatch-usb-creator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Netdispatch.UsbCreator.Core.csproj" />
    <ProjectReference Include="..\Windows\Netdispatch.UsbCreator.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
  </ItemGroup>
</Project>
