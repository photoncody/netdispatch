<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows disk backend (Storage module via PowerShell, raw writes) and the DPAPI
       settings store. Plain net10.0 so it builds on Linux; it only runs on Windows. -->
  <PropertyGroup>
    <RootNamespace>Netdispatch.UsbCreator.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\Netdispatch.UsbCreator.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
