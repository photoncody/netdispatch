<Project>
  <!--
    Shared settings for our own projects. This file lives in src/ (and is imported from tests/)
    rather than in the unattendgen folder on purpose: MSBuild imports the nearest
    Directory.Build.props walking upwards, and a file there would also apply to
    external/unattend-generator.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      The single-file analyzer would add an implicit Microsoft.NET.ILLink.Tasks reference
      whenever PublishSingleFile is set, so packages.lock.json would differ between a plain
      restore and a publish. The program is not trimmed, so the analyzer adds nothing.
    -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>
